<%- include('partials/head', { page }) %>
<div class="app-shell">
  <%- include('partials/sidebar', { page: { ...page, nav: [['Overview','/hr','grid'],['Employee directory','/hr/employees','users'],['Onboarding','#','user-plus'],['Leave requests','/manager/leaves','calendar'],['Attendance','#','clock'],['Reports','#','chart'],['Settings','#','settings']], active: 'Employee directory' }, role, iconSvg }) %>
  <main class="main-column"><%- include('partials/topbar', { role }) %>
    <section class="page-content">
      <div class="page-heading"><div><div class="eyebrow"><span class="eyebrow-dot"></span> HR WORKSPACE</div><h1>Employee directory</h1><p>Find, review and maintain employee records across the organisation.</p></div><button class="button button-primary" id="addEmployeeBtn"><span>＋</span> Add employee</button></div>
      <div class="metric-grid metric-grid-four">
        <article class="metric-card"><div class="metric-top"><span class="metric-label">Total employees</span><span class="metric-icon metric-icon-purple"><%- iconSvg('users') %></span></div><div class="metric-value">248</div><div class="metric-note note-neutral">Across all departments</div></article>
        <article class="metric-card"><div class="metric-top"><span class="metric-label">Active</span><span class="metric-icon metric-icon-green"><%- iconSvg('user') %></span></div><div class="metric-value">239</div><div class="metric-note note-positive">96.4% of workforce</div></article>
        <article class="metric-card"><div class="metric-top"><span class="metric-label">Onboarding</span><span class="metric-icon metric-icon-blue"><%- iconSvg('user-plus') %></span></div><div class="metric-value">06</div><div class="metric-note note-neutral">In progress</div></article>
        <article class="metric-card"><div class="metric-top"><span class="metric-label">Inactive</span><span class="metric-icon metric-icon-amber"><%- iconSvg('users') %></span></div><div class="metric-value">03</div><div class="metric-note note-neutral">Recently offboarded</div></article>
      </div>
      <section class="panel directory-panel">
        <div class="directory-toolbar"><label class="table-search"><span>⌕</span><input id="employeeSearch" type="search" placeholder="Search by name, email or employee ID"></label><select id="departmentFilter" class="filter-select"><option value="">All departments</option><option>Engineering</option><option>People &amp; Culture</option><option>Finance</option><option>Marketing</option><option>Operations</option></select><select id="statusFilter" class="filter-select"><option value="">All statuses</option><option>Active</option><option>Onboarding</option><option>Inactive</option></select><button class="button button-quiet" id="clearFilters">Clear filters</button></div>
        <div class="panel-heading directory-heading"><div><h2>All employees</h2><p><span id="employeeCount"><%= employees.length %></span> sample records shown · 248 total in workspace</p></div><button class="button button-outline button-small" onclick="window.print()">Export list <span>↓</span></button></div>
        <div class="table-scroll"><table class="data-table directory-table"><thead><tr><th>EMPLOYEE</th><th>DEPARTMENT</th><th>DESIGNATION</th><th>JOINED</th><th>STATUS</th><th></th></tr></thead><tbody id="employeeRows">
          <% employees.forEach(emp => { %><tr data-department="<%= emp.department %>" data-status="<%= emp.status %>"><td><div class="person-cell"><span class="avatar avatar-soft"><%= emp.initials %></span><span class="person-copy"><strong><%= emp.name %></strong><small><%= emp.email %> · <%= emp.id %></small></span></div></td><td><%= emp.department %></td><td class="muted-cell"><%= emp.designation %></td><td class="muted-cell"><%= emp.joined %></td><td><span class="status status-<%= emp.status === 'Active' ? 'success' : emp.status === 'Inactive' ? 'neutral' : 'info' %>"><i></i><%= emp.status %></span></td><td><button class="icon-button row-menu" aria-label="Employee actions">•••</button></td></tr><% }) %>
        </tbody></table></div>
        <div class="panel-foot"><span id="directoryFoot">Showing <%= employees.length %> sample employees</span><div class="pagination"><button disabled>‹</button><button class="current">1</button><button>2</button><button>3</button><span>…</span><button>50</button><button>›</button></div></div>
      </section>
    </section>
  </main>
</div>
<div class="modal-backdrop" id="employeeModal" aria-hidden="true"><section class="modal-card"><div class="modal-head"><div><span class="eyebrow">NEW RECORD</span><h2>Add employee</h2><p>Create an employee profile in the directory.</p></div><button class="icon-button" id="closeEmployeeModal">×</button></div><form id="employeeForm" class="modal-form"><label>Full name<input name="name" required placeholder="e.g. Ananya Singh"></label><label>Work email<input name="email" type="email" required placeholder="name@company.com"></label><div class="form-row"><label>Department<select name="department"><option>Engineering</option><option>People &amp; Culture</option><option>Finance</option><option>Marketing</option><option>Operations</option></select></label><label>Designation<input name="designation" required placeholder="Job title"></label></div><div class="modal-actions"><button type="button" class="button button-quiet" id="cancelEmployeeModal">Cancel</button><button class="button button-primary" type="submit">Save employee</button></div></form></section></div>
<%- include('partials/scripts', { notice }) %>
