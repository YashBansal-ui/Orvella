<%- include('partials/head', { page }) %>
<%
  function iconSvg(name) {
    const paths = {
      grid:'<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
      users:'<path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M20 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
      layers:'<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5M3 16l9 5 9-5"/>',
      calendar:'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/>',
      clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
      chart:'<path d="M4 19V5M4 19h17"/><path d="m7 15 4-4 3 2 6-7"/>',
      shield:'<path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"/><path d="m9 12 2 2 4-4"/>',
      'user-plus':'<path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M19 8v6M16 11h6"/>',
      clipboard:'<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4.5h6a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1ZM9 10h6M9 14h6M9 18h3"/>',
      settings:'<circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1 1.4 1.1-1.4 2.4-1.7-.6a8 8 0 0 1-1.5.9l-.3 1.8h-2.8l-.3-1.8a8 8 0 0 1-1.5-.9l-1.7.6-1.4-2.4 1.4-1.1a7 7 0 0 1 0-1.8l-1.4-1.1 1.4-2.4 1.7.6a8 8 0 0 1 1.5-.9l.3-1.8h2.8l.3 1.8a8 8 0 0 1 1.5.9l1.7-.6 1.4 2.4-1.4 1.1a7 7 0 0 1 0 1.8Z"/>',
      user:'<path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/>',
      'calendar-plus':'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M12 13v5M9.5 15.5h5"/>',
      history:'<path d="M3 12a9 9 0 1 0 2.6-6.4L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/>',
      file:'<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8M8 17h8"/>',
      coffee:'<path d="M10 2v2M14 2v2M4 8h14v8a4 4 0 0 1-4 4h-6a4 4 0 0 1-4-4V8ZM18 10h1a2 2 0 1 1 0 4h-1"/>',
      heart:'<path d="M20.8 8.8c0 5.5-8.8 11-8.8 11s-8.8-5.5-8.8-11A4.8 4.8 0 0 1 12 6.5a4.8 4.8 0 0 1 8.8 2.3Z"/>',
      hourglass:'<path d="M6 2h12M6 22h12M7 2c0 5 5 5 5 10s-5 5-5 10M17 2c0 5-5 5-5 10s5 5 5 10"/>'
    };
    return `<svg viewBox="0 0 24 24" aria-hidden="true">${paths[name] || paths.grid}</svg>`;
  }
%>
<div class="app-shell">
  <%- include('partials/sidebar', { page, role, iconSvg }) %>
  <main class="main-column">
    <%- include('partials/topbar', { role }) %>
    <section class="page-content">
      <div class="page-heading">
        <div><div class="eyebrow"><span class="eyebrow-dot"></span><%= role.toUpperCase() %> WORKSPACE</div><h1><%= page.title %></h1><p><%= page.subtitle %></p></div>
        <% if (role === 'employee') { %><a class="button button-primary" href="/employee/leave/apply"><span>＋</span> Apply for leave</a><% } else if (role === 'manager') { %><a class="button button-primary" href="/manager/leaves">Review requests <span>↗</span></a><% } else { %><a class="button button-primary" href="/hr/employees"><span>＋</span> Add employee</a><% } %>
      </div>
      <div class="metric-grid">
        <% data.metrics.forEach((metric, i) => { %>
          <article class="metric-card"><div class="metric-top"><span class="metric-label"><%= metric.label %></span><span class="metric-icon metric-icon-<%= metric.tone %>"><%- iconSvg(metric.icon) %></span></div><div class="metric-value"><%= metric.value %></div><div class="metric-note note-<%= metric.tone %>"><span class="note-indicator"><%= metric.tone === 'positive' ? '↗' : metric.tone === 'warning' ? '!' : '·' %></span><%= metric.note %></div></article>
        <% }) %>
      </div>
      <div class="dashboard-grid">
        <section class="panel table-panel">
          <div class="panel-heading"><div><h2><%= data.tableTitle %></h2><p><%= role === 'manager' ? 'Requests assigned to your team' : role === 'employee' ? 'Your recent time-off activity' : 'A quick view of the latest updates' %></p></div><a href="<%= role === 'manager' ? '/manager/leaves' : role === 'employee' ? '/employee/leave/apply' : '/hr/employees' %>" class="text-link"><%= data.tableAction %> <span>→</span></a></div>
          <div class="table-scroll"><table class="data-table"><thead><tr><th><%= role === 'employee' ? 'LEAVE TYPE' : 'EMPLOYEE' %></th><th>DETAIL</th><th>DATE</th><th>STATUS</th><th></th></tr></thead><tbody>
            <% data.rows.forEach(row => { %><tr><td><div class="person-cell"><span class="avatar avatar-soft"><%= row.initials %></span><strong><%= row.name %></strong></div></td><td class="muted-cell"><%= row.detail %></td><td class="muted-cell"><%= row.date %></td><td><span class="status status-<%= row.tone %>"><i></i><%= row.status %></span></td><td><a class="row-action" href="<%= role === 'manager' ? '/manager/leaves' : role === 'employee' ? '/employee/leave/apply' : '/hr/employees' %>">View</a></td></tr><% }) %>
          </tbody></table></div>
          <div class="panel-foot"><span>Updated just now</span><a href="<%= role === 'manager' ? '/manager/leaves' : '/hr/employees' %>">Open full view <span>↗</span></a></div>
        </section>
        <section class="panel insight-panel">
          <div class="panel-heading"><div><h2><%= data.insightTitle %></h2><p><%= data.insightDescription %></p></div><button class="icon-button subtle-button" aria-label="More options">•••</button></div>
          <div class="insight-list"><% data.insights.forEach(item => { %><div class="insight-item"><div class="insight-meta"><span><%= item.label %></span><strong><%= item.value %></strong></div><div class="progress-track"><span class="progress-fill fill-<%= item.color %>" style="width:<%= item.percent %>%"></span></div></div><% }) %></div>
          <div class="insight-footer"><span class="legend-dot"></span><span><%= role === 'employee' ? 'Remaining balance' : 'Current distribution' %></span><span class="insight-period">This month <span>⌄</span></span></div>
        </section>
      </div>
      <section class="panel activity-panel"><div class="activity-intro"><span class="activity-icon">◷</span><div><h2>Recent activity</h2><p>Latest updates across your workspace</p></div></div><div class="activity-items"><% data.activity.forEach(item => { %><article class="activity-item"><span class="activity-time"><%= item.time %></span><p><%= item.text %></p><span class="activity-tag"><%= item.tag %></span></article><% }) %></div><a class="activity-more" href="#">View activity <span>→</span></a></section>
    </section>
  </main>
</div>
<%- include('partials/scripts', { notice }) %>
