<aside class="sidebar" id="sidebar">
  <a class="brand" href="/<%= role === 'hr' ? 'hr' : role %>">
    <span class="brand-mark">P</span>
    <span class="brand-copy"><strong>orvella</strong><small>WORKFORCE PLATFORM</small></span>
  </a>
  <div class="nav-caption">WORKSPACE</div>
  <nav class="side-nav">
    <% page.nav.forEach(([label, href, icon]) => { %>
      <a class="nav-link <%= page.active === label ? 'active' : '' %>" href="<%= href %>">
        <span class="nav-icon"><%- iconSvg(icon) %></span><span><%= label %></span>
        <% if (label === 'Leave approvals' && role === 'manager') { %><span class="nav-count">3</span><% } %>
      </a>
    <% }) %>
  </nav>
  <div class="sidebar-bottom">
    <div class="help-card"><span class="help-icon">✦</span><div><strong>Need a hand?</strong><small>Visit the HR help centre</small></div><span class="help-arrow">↗</span></div>
    <div class="sidebar-profile"><div class="avatar avatar-dark"><%= role === 'employee' ? 'AM' : role === 'manager' ? 'SK' : role === 'hr' ? 'HR' : 'AD' %></div><div class="profile-copy"><strong><%= role === 'employee' ? 'Aarav Mehta' : role === 'manager' ? 'Simran Khanna' : role === 'hr' ? 'Priya Sharma' : 'Admin User' %></strong><small><%= role.charAt(0).toUpperCase() + role.slice(1) %> account</small></div><span class="more-dots">•••</span></div>
  </div>
</aside>
